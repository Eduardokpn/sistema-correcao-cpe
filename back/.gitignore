# Any directory starting with a dot
**/\.*/
# Except .github
!.github/
# ...and .streamlit, que carrega o tema da identidade visual
!.streamlit/

# Grading files of the local API (see grading/artifacts.py)
outputs/*

# Misc
**/.DS_Store
**/__pycache__
venv/
OMRChecker.wiki/

# Local SQLite database (dev default; production uses CPE_DATABASE_URL)
*.db
