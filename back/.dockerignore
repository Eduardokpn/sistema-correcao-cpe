# Read by `docker build` because the build context is back/ (see docker-compose.yml)
.git
.venv
venv
**/__pycache__
**/*.pyc
**/.pytest_cache
.mypy_cache
.coverage
**/.DS_Store
# Local database and grading outputs stay out of the image
*.db
outputs
# The engine's samples, docs and scratch folders are not needed at runtime
omrchecker/samples
omrchecker/docs
omrchecker/inputs
omrchecker/outputs
